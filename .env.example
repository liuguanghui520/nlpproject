# Copy to .env locally. Never commit .env or paste API keys into chat.
# No provider is selected yet; blank fields intentionally disable live model access.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Set according to the chosen provider's actual context/output limits before live calls.
LLM_CONTEXT_TOKEN_LIMIT=
LLM_MAX_OUTPUT_TOKENS=
# Set to true only for a deliberately configured service that does not require an API key.
LLM_ALLOW_NO_API_KEY=false
